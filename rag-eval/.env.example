# Copia este archivo a .env.local en la raíz del repo (o exporta las variables).
# Nunca escribas valores aquí.

# Supabase. Para la evaluación usa el proyecto de DESARROLLO (cyberchat-rag-eval-dev), no
# producción: pon su URL y su service_role en un archivo aparte, .env.rag-eval.local
# (ignorado por git), y ejecuta los scripts con --env-file=.env.rag-eval.local.
RAG_EVAL_DEV_PROJECT_REF=prgipedtijbryajvvenj
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Embeddings (Hugging Face) y generador (Groq)
HF_TOKEN=
GROQ_API_KEY=

# Ruta absoluta al mapeo alias -> id del administrador. Debe estar FUERA del repositorio.
RAG_EVAL_ORG_MAP=

# Modelo juez de RAGAS (distinto del generador). Se define en la Parada A.
RAG_EVAL_JUDGE_PROVIDER=
RAG_EVAL_JUDGE_MODEL=
RAG_EVAL_JUDGE_API_KEY=
