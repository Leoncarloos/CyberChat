<mxCell id="n27" value="&lt;span style=&quot;font-size:16px&quot;&gt;•  Prioriza los temas más débiles&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Prompts de arranque por tema&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Recomendaciones personalizadas&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Progreso por tema:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;    pendiente · en progreso ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;    completado&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="795" y="521" width="296" height="157" as="geometry"/></mxCell>
