<mxCell id="n18" value="&lt;span style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Cómo leer este diagrama&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;1 - 6  Funciones de la plataforma&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;IA&lt;/b&gt;  Usa inteligencia artificial&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;→  Alimenta o conduce a la siguiente&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1193" y="120" width="340" height="100" as="geometry"/></mxCell>
