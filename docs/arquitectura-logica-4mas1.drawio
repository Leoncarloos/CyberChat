<mxCell id="n16" value="&lt;span style=&quot;font-size:16px&quot;&gt;•  Sube políticas y guías&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;    (PDF, Word o TXT)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  La plataforma los lee y organiza&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Solo su empresa puede usarlos&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Se pueden eliminar o reprocesar&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="788" y="184" width="345" height="190" as="geometry"/></mxCell>
