<mxCell id="n21" value="&lt;span style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Diagnóstico y evaluaciones&lt;/b&gt;&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="347" y="469" width="245" height="30" as="geometry"/></mxCell>
<mxCell id="n22" value="&lt;span style=&quot;font-size:16px&quot;&gt;•  Diagnóstico inicial: 16 preguntas&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Post-test para medir la mejora&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Nueva evaluación cada 5 días&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Resultado por tema:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;    Bajo · Medio · Alto&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="302" y="521" width="345" height="157" as="geometry"/></mxCell>
