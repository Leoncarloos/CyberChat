<mxCell id="n12" value="&lt;span style=&quot;font-size:16px&quot;&gt;•  Registra la empresa (RUC)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Los empleados solicitan acceso&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  El administrador aprueba o rechaza&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Cada persona ingresa con su cuenta&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="302" y="182" width="345" height="190" as="geometry"/></mxCell>
