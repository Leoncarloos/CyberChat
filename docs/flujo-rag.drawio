<mxCell id="i1" value="&lt;span style=&quot;font-size:21px&quot;&gt;Sube el documento&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;PDF, DOCX o TXT · máx. 10&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;MiB · sin OCR: un PDF&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;escaneado sin texto se rechaza&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="143" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="i2" value="&lt;span style=&quot;font-size:21px&quot;&gt;Extrae y limpia el texto&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;pdf-extraction (PDF) · mammoth&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;(DOCX) · UTF-8 (TXT)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="428" y="143" width="318" height="159" as="geometry"/></mxCell>
<mxCell id="i3" value="&lt;span style=&quot;font-size:21px&quot;&gt;Fragmenta por oraciones&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;máximo 800 caracteres por&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;fragmento · solape de 1 oración&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="824" y="143" width="318" height="159" as="geometry"/></mxCell>
<mxCell id="i4" value="&lt;span style=&quot;font-size:21px&quot;&gt;Genera un embedding&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;por fragmento&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Hugging Face · paraphrase-&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;multilingual-MiniLM-L12-v2 ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;384 dim. · solo los primeros&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;512 caracteres&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="1236" y="143" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="i5" value="&lt;span style=&quot;font-size:21px&quot;&gt;Guarda en Supabase&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;archivo en Storage · fragmentos&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;y vectores en PostgreSQL con&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;pgvector (índice HNSW,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;distancia coseno)&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1633" y="135" width="302" height="175" as="geometry"/></mxCell>
<mxCell id="q1" value="&lt;span style=&quot;font-size:21px&quot;&gt;El usuario pregunta en el chat&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;el servidor recibe el historial;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;la búsqueda usa solo el último&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;mensaje&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q2" value="&lt;span style=&quot;font-size:21px&quot;&gt;Autentica al usuario&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;sesión de Supabase Auth · cuenta&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;activa · rol y RUC leídos de&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;app_metadata&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="444" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q3" value="&lt;span style=&quot;font-size:21px&quot;&gt;Genera el embedding&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;de la consulta&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;mismo modelo que la fase 1 ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;primeros 512 caracteres&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="840" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q4" value="&lt;span style=&quot;font-size:21px&quot;&gt;Resuelve la organización&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;y busca&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;RUC de la sesión → administrador&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;dueño (si no existe, usa el id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;del propio usuario) · coseno&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;con índice HNSW · 5 candidatos&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1236" y="484" width="302" height="207" as="geometry"/></mxCell>
<mxCell id="q5" value="&lt;span style=&quot;font-size:21px&quot;&gt;Filtra los resultados&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;quita duplicados (primeros 100&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;caracteres) · descarta similitud&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;&amp;lt; 0.38 · no repone candidatos&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1633" y="508" width="302" height="159" as="geometry"/></mxCell>
