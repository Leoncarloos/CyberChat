<mxCell id="title" value="Flujo RAG de CyberChat&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Retrieval-Augmented Generation: recuperar fragmentos de los documentos de la empresa y generar la respuesta con ellos&lt;/font&gt;" style="text;html=1;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="50" as="geometry"/></mxCell>
