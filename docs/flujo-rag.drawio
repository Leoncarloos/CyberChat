<mxCell id="n1" value="&lt;span style=&quot;font-size:27px&quot;&gt;&lt;b&gt;Flujo RAG de CyberChat&lt;/b&gt;&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1a1a1a;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="3" y="6" width="900" height="40" as="geometry"/></mxCell>
<mxCell id="i1" value="&lt;span style=&quot;font-size:21px&quot;&gt;Sube el documento&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;PDF, DOCX o TXT · máx. 10 MB ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;sin OCR: un documento sin&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;texto legible se rechaza&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="143" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="i2" value="&lt;span style=&quot;font-size:21px&quot;&gt;Extrae y limpia el texto&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;pdf-extraction (PDF) · mammoth&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;(DOCX) · UTF-8 (TXT)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="428" y="143" width="318" height="159" as="geometry"/></mxCell>
<mxCell id="i3" value="&lt;span style=&quot;font-size:21px&quot;&gt;Fragmenta por secciones&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;y oraciones&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;máx. 120 tokens por fragmento,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;con «Documento» y «Sección» ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;solapa 1 oración corta&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="824" y="143" width="318" height="159" as="geometry"/></mxCell>
<mxCell id="i4" value="&lt;span style=&quot;font-size:21px&quot;&gt;Genera un embedding&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;por fragmento&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Hugging Face · paraphrase-&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;multilingual-MiniLM-L12-v2 ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;384 dim. · sin recortar texto&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="1236" y="143" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="i5" value="&lt;span style=&quot;font-size:21px&quot;&gt;Guarda en Supabase&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;archivo en Storage · fragmentos&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;y vectores en PostgreSQL con&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;pgvector (índice HNSW,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;distancia coseno)&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1633" y="135" width="302" height="175" as="geometry"/></mxCell>
<mxCell id="q1" value="&lt;span style=&quot;font-size:21px&quot;&gt;El usuario pregunta en el chat&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;el servidor recibe el historial;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;la búsqueda usa solo el último&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;mensaje&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q2" value="&lt;span style=&quot;font-size:21px&quot;&gt;Autentica al usuario&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;sesión de Supabase Auth · cuenta&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;activa · rol y RUC leídos de&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;app_metadata&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="444" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q3" value="&lt;span style=&quot;font-size:21px&quot;&gt;Genera el embedding&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;de la consulta&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;mismo modelo · si pasa de 120&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;tokens se divide (máx. 8&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;partes) y se promedia&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="840" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q4" value="&lt;span style=&quot;font-size:21px&quot;&gt;Búsqueda híbrida en&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;su empresa&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;RUC → administrador dueño ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;vectorial: 20 candidatos ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;léxica: texto completo · fusión&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;RRF: máx. 20 sin duplicados&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1236" y="484" width="302" height="207" as="geometry"/></mxCell>
<mxCell id="q5" value="&lt;span style=&quot;font-size:21px&quot;&gt;Selecciona la evidencia&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Groq · gpt-oss-20b elige hasta&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;5 fragmentos · si falla: los 5&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;más similares por vector&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;(similitud ≥ 0.38)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="1633" y="484" width="302" height="207" as="geometry"/></mxCell>
<mxCell id="q6" value="&lt;span style=&quot;font-size:21px&quot;&gt;¿Hay&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;evidencia?&lt;/span&gt;" style="rhombus;html=1;fontFamily=Helvetica;fontSize=21;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1633" y="730" width="302" height="174" as="geometry"/></mxCell>
<mxCell id="q7" value="&lt;span style=&quot;font-size:21px&quot;&gt;Prompt con contexto documental&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;fragmentos numerados · cada&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;afirmación lleva [Fuente N]&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1173" y="746" width="333" height="127" as="geometry"/></mxCell>
<mxCell id="q8" value="&lt;span style=&quot;font-size:21px&quot;&gt;Sin evidencia documental&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;pregunta sobre políticas de la&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;empresa → respuesta fija · otra&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;pregunta → prompt general&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1173" y="919" width="333" height="127" as="geometry"/></mxCell>
<mxCell id="q9" value="&lt;span style=&quot;font-size:21px&quot;&gt;El LLM genera la respuesta&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Groq · openai/gpt-oss-20b ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;últimos 12 mensajes · temp. 0.15&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;· máx. 900 tokens · negativa&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;genérica → mensaje de alcance&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="697" y="746" width="333" height="160" as="geometry"/></mxCell>
<mxCell id="q11" value="&lt;span style=&quot;font-size:21px&quot;&gt;Respuesta fija, sin LLM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;«No encontré evidencia&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;suficiente…»&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="697" y="950" width="333" height="110" as="geometry"/></mxCell>
<mxCell id="q10" value="&lt;span style=&quot;font-size:21px&quot;&gt;Respuesta al usuario&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;fuentes: documento, similitud y&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;vista previa · el chat muestra&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;citas [1] y «Fragmentos citados»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;y guarda la respuesta con los&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;fragmentos usados&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="207" y="746" width="333" height="175" as="geometry"/></mxCell>
