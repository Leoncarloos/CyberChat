<mxCell id="n32" value="&lt;span style=&quot;font-size:16px&quot;&gt;•  Answers cybersecurity questions&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Uses the company's documents&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Shows which fragments it used&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  No documents: general answer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Keeps the chat history&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1190" y="521" width="306" height="157" as="geometry"/></mxCell>
