<mxCell id="n18" value="&lt;span style=&quot;font-size:17px&quot;&gt;&lt;b&gt;How to read this diagram&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;1 - 6  Platform functions&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;AI&lt;/b&gt;  Uses artificial intelligence&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;→  Feeds or leads to the next one&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1193" y="120" width="340" height="100" as="geometry"/></mxCell>
