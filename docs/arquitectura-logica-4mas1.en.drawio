<mxCell id="n21" value="&lt;span style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Diagnostic and assessments&lt;/b&gt;&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="347" y="469" width="245" height="30" as="geometry"/></mxCell>
<mxCell id="n22" value="&lt;span style=&quot;font-size:16px&quot;&gt;•  Initial diagnostic: 16 questions&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Post-test to measure improvement&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  New assessment every 5 days&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;•  Result per topic:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;    Low · Medium · High&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="302" y="521" width="345" height="157" as="geometry"/></mxCell>
