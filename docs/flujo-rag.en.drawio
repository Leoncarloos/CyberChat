<mxCell id="n1" value="&lt;span style=&quot;font-size:27px&quot;&gt;&lt;b&gt;CyberChat RAG flow&lt;/b&gt;&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1a1a1a;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="3" y="6" width="900" height="40" as="geometry"/></mxCell>
<mxCell id="i1" value="&lt;span style=&quot;font-size:21px&quot;&gt;Uploads document&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;PDF, DOCX or TXT · max. 10&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;MiB · no OCR: a scanned PDF&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;without text is rejected&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="143" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="i2" value="&lt;span style=&quot;font-size:21px&quot;&gt;Extracts and cleans the text&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;pdf-extraction (PDF) · mammoth&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;(DOCX) · UTF-8 (TXT)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="428" y="143" width="318" height="159" as="geometry"/></mxCell>
<mxCell id="i3" value="&lt;span style=&quot;font-size:21px&quot;&gt;Splits by sentences&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;at most 800 characters per&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;fragment · 1-sentence overlap&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="824" y="143" width="318" height="159" as="geometry"/></mxCell>
<mxCell id="i4" value="&lt;span style=&quot;font-size:21px&quot;&gt;Generates one embedding&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;per fragment&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Hugging Face · paraphrase-&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;multilingual-MiniLM-L12-v2 ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;384 dim. · first 512 characters&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;only&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="1236" y="143" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="i5" value="&lt;span style=&quot;font-size:21px&quot;&gt;Stores in Supabase&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;file in Storage · fragments and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;vectors in PostgreSQL with&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;pgvector (HNSW index, cosine&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;distance)&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1633" y="135" width="302" height="175" as="geometry"/></mxCell>
<mxCell id="q1" value="&lt;span style=&quot;font-size:21px&quot;&gt;User asks in the chat&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;the server receives the history;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;retrieval uses only the last&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;message&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q2" value="&lt;span style=&quot;font-size:21px&quot;&gt;Authenticates the user&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Supabase Auth session · active&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;account · role and RUC read&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;from app_metadata&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="444" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q3" value="&lt;span style=&quot;font-size:21px&quot;&gt;Generates the query&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;embedding&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;same model as phase 1 · first&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;512 characters&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="840" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q4" value="&lt;span style=&quot;font-size:21px&quot;&gt;Resolves the organization&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;and searches&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;session RUC → owning&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;administrator (if not found, falls&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;back to the user's own id) ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;cosine with HNSW index · 5&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;candidates&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1236" y="484" width="302" height="207" as="geometry"/></mxCell>
<mxCell id="q5" value="&lt;span style=&quot;font-size:21px&quot;&gt;Filters results&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;removes duplicates (first 100&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;chars) · discards similarity &amp;lt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;0.38 · no replenishment of&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;candidates&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1633" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q6" value="&lt;span style=&quot;font-size:21px&quot;&gt;Fragments left?&lt;/span&gt;" style="rhombus;html=1;fontFamily=Helvetica;fontSize=21;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1633" y="714" width="302" height="174" as="geometry"/></mxCell>
<mxCell id="q7" value="&lt;span style=&quot;font-size:21px&quot;&gt;Prompt with document context&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;fragments + scope rules&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1173" y="746" width="333" height="111" as="geometry"/></mxCell>
<mxCell id="q8" value="&lt;span style=&quot;font-size:21px&quot;&gt;General-knowledge prompt&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;answer without document support ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;suggests uploading documents&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1173" y="889" width="333" height="127" as="geometry"/></mxCell>
<mxCell id="q9" value="&lt;span style=&quot;font-size:21px&quot;&gt;LLM generates the answer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Groq · openai/gpt-oss-20b · last 12&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;messages · temp. 0.15 · max. 900&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;tokens&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="697" y="753" width="333" height="143" as="geometry"/></mxCell>
<mxCell id="q10" value="&lt;span style=&quot;font-size:21px&quot;&gt;Answer to the user&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;indicates whether it used context ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;sources with similarity % and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;preview (220 chars)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="207" y="762" width="333" height="127" as="geometry"/></mxCell>
