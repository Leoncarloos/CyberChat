<mxCell id="n1" value="&lt;span style=&quot;font-size:27px&quot;&gt;&lt;b&gt;CyberChat RAG flow&lt;/b&gt;&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1a1a1a;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="3" y="6" width="900" height="40" as="geometry"/></mxCell>
<mxCell id="i1" value="&lt;span style=&quot;font-size:21px&quot;&gt;Uploads document&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;PDF, DOCX or TXT · max. 10 MB ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;no OCR: a document without&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;readable text is rejected&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="143" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="i2" value="&lt;span style=&quot;font-size:21px&quot;&gt;Extracts and cleans the text&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;pdf-extraction (PDF) · mammoth&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;(DOCX) · UTF-8 (TXT)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="428" y="143" width="318" height="159" as="geometry"/></mxCell>
<mxCell id="i3" value="&lt;span style=&quot;font-size:21px&quot;&gt;Splits by sections&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;and sentences&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;max. 120 tokens per fragment,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;with «Document» and «Section» ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;overlaps 1 short sentence&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="824" y="143" width="318" height="159" as="geometry"/></mxCell>
<mxCell id="i4" value="&lt;span style=&quot;font-size:21px&quot;&gt;Generates one embedding&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;per fragment&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Hugging Face · paraphrase-&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;multilingual-MiniLM-L12-v2 ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;384 dim. · no text truncation&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="1236" y="143" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="i5" value="&lt;span style=&quot;font-size:21px&quot;&gt;Stores in Supabase&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;file in Storage · fragments and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;vectors in PostgreSQL with&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;pgvector (HNSW index, cosine&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;distance)&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1633" y="135" width="302" height="175" as="geometry"/></mxCell>
<mxCell id="q1" value="&lt;span style=&quot;font-size:21px&quot;&gt;User asks in the chat&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;the server receives the history;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;retrieval uses only the last&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;message&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q2" value="&lt;span style=&quot;font-size:21px&quot;&gt;Authenticates the user&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Supabase Auth session · active&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;account · role and RUC read&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;from app_metadata&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="444" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q3" value="&lt;span style=&quot;font-size:21px&quot;&gt;Generates the query&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;embedding&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;same model · over 120 tokens it&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;is split (max. 8 parts) and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;averaged&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="840" y="508" width="302" height="159" as="geometry"/></mxCell>
<mxCell id="q4" value="&lt;span style=&quot;font-size:21px&quot;&gt;Hybrid search in&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;the company&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;RUC → owning administrator ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;vector: 20 candidates ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;lexical: full text · RRF&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;fusion: max. 20, no duplicates&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1236" y="484" width="302" height="207" as="geometry"/></mxCell>
<mxCell id="q5" value="&lt;span style=&quot;font-size:21px&quot;&gt;Selects the evidence&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Groq · gpt-oss-20b picks up to&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;5 fragments · if it fails: the&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;5 most similar by vector&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;(similarity ≥ 0.38)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="1633" y="484" width="302" height="207" as="geometry"/></mxCell>
<mxCell id="q6" value="&lt;span style=&quot;font-size:21px&quot;&gt;Any&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;evidence?&lt;/span&gt;" style="rhombus;html=1;fontFamily=Helvetica;fontSize=21;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1633" y="730" width="302" height="174" as="geometry"/></mxCell>
<mxCell id="q7" value="&lt;span style=&quot;font-size:21px&quot;&gt;Prompt with document context&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;numbered fragments · each&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;statement carries [Fuente N]&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1173" y="746" width="333" height="127" as="geometry"/></mxCell>
<mxCell id="q8" value="&lt;span style=&quot;font-size:21px&quot;&gt;No document evidence&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;question about company policy →&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;fixed answer · other question →&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;general prompt&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1173" y="919" width="333" height="127" as="geometry"/></mxCell>
<mxCell id="q9" value="&lt;span style=&quot;font-size:21px&quot;&gt;LLM generates the answer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Groq · openai/gpt-oss-20b · last&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;12 messages · temp. 0.15 · max.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;900 tokens · generic refusal →&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;scope message&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e8eef7;strokeColor=#1f3a5f;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="697" y="746" width="333" height="160" as="geometry"/></mxCell>
<mxCell id="q11" value="&lt;span style=&quot;font-size:21px&quot;&gt;Fixed answer, no LLM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;«No encontré evidencia&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;suficiente…» (not enough evidence)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="697" y="950" width="333" height="110" as="geometry"/></mxCell>
<mxCell id="q10" value="&lt;span style=&quot;font-size:21px&quot;&gt;Answer to the user&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;sources: document, similarity and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;preview · the chat shows [1]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;citations and «Fragmentos&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;citados» and saves the answer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;with the fragments used&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#1a1a1a;align=center;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="207" y="746" width="333" height="175" as="geometry"/></mxCell>
